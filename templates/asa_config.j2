!
! Cisco ASA Configuration
! Generated by Cisco Configuration Generator
! Hostname: {{ hostname }}
! Platform: {{ platform }}
!
hostname {{ hostname }}
!
{% if domain_name %}
domain-name {{ domain_name }}
{% endif %}
!
{% if enable_secret %}
enable password {{ enable_secret }}
{% endif %}
!
{% if aaa and aaa.tacacs_servers %}
! AAA Configuration
aaa-server TACACS protocol tacacs+
{% for server in aaa.tacacs_servers %}
aaa-server TACACS (inside) host {{ server.host }}
{% if server.key %}
  key {{ server.key }}
{% endif %}
{% endfor %}
aaa authentication ssh console TACACS LOCAL
aaa authorization exec authentication-server
!
{% endif %}
!
{% if aaa and aaa.local_users %}
! Local Users
{% for username, password in aaa.local_users.items() %}
username {{ username }} password {{ password }} privilege 15
{% endfor %}
{% endif %}
!
{% if interfaces %}
! Interface Configuration
{% for interface in interfaces %}
interface {{ interface.name }}
{% if interface.description %}
 description {{ interface.description }}
{% endif %}
 nameif {{ interface.name | replace('GigabitEthernet', 'outside') }}
{% if interface.ip_address and interface.subnet_mask %}
 ip address {{ interface.ip_address }} {{ interface.subnet_mask }}
{% endif %}
 security-level {{ interface.security_level | default('0') }}
{% if interface.enabled is defined and not interface.enabled %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
{% endfor %}
{% endif %}
!
{% if static_routes %}
! Static Routes
{% for route in static_routes %}
route {% if route.interface %}{{ route.interface }}{% else %}outside{% endif %} {{ route.network }} {{ route.mask | default('255.255.255.255') }} {{ route.next_hop }}{% if route.distance %} {{ route.distance }}{% endif %}

{% endfor %}
!
{% endif %}
!
{% if ospf and ospf.enabled %}
! OSPF Configuration
router ospf {{ ospf.process_id }}
{% if ospf.router_id %}
 router-id {{ ospf.router_id }}
{% endif %}
{% if ospf.networks %}
{% for network in ospf.networks %}
 network {{ network.network }} {{ network.wildcard }} area {{ network.area }}
{% endfor %}
{% endif %}
!
{% endif %}
!
{% if ntp_servers %}
! NTP Configuration
{% for server in ntp_servers %}
ntp server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if dns_servers %}
! DNS Configuration
dns domain-lookup inside
{% for server in dns_servers %}
dns name-server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if syslog_servers %}
! Syslog Configuration
logging enable
{% for server in syslog_servers %}
logging host inside {{ server }}
{% endfor %}
logging trap informational
!
{% endif %}
!
{% if snmp_community %}
! SNMP Configuration
snmp-server community {{ snmp_community }}
{% if snmp_location %}
snmp-server location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-server contact {{ snmp_contact }}
{% endif %}
!
{% endif %}
!
{% if banner_motd %}
banner motd {{ banner_motd }}
!
{% endif %}
!
ssh timeout 30
ssh version 2
!
end
