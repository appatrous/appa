!
! Cisco IOS Configuration
! Generated by Cisco Configuration Generator
! Hostname: {{ hostname }}
! Platform: {{ platform }}
!
version 15.2
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname {{ hostname }}
!
{% if domain_name %}
ip domain-name {{ domain_name }}
{% endif %}
!
{% if enable_secret %}
enable secret {{ enable_secret }}
{% endif %}
!
{% if aaa and aaa.tacacs_servers %}
! AAA Configuration
aaa new-model
{% for server in aaa.tacacs_servers %}
tacacs-server host {{ server.host }}{% if server.key %} key {{ server.key }}{% endif %}

{% endfor %}
aaa authentication login default group tacacs+ local
aaa authorization exec default group tacacs+ local
aaa accounting exec default start-stop group tacacs+
{% endif %}
!
{% if aaa and aaa.local_users %}
! Local Users
{% for username, password in aaa.local_users.items() %}
username {{ username }} privilege 15 secret {{ password }}
{% endfor %}
{% endif %}
!
{% if interfaces %}
! Interface Configuration
{% for interface in interfaces %}
interface {{ interface.name }}
{% if interface.description %}
 description {{ interface.description }}
{% endif %}
{% if interface.ip_address and interface.subnet_mask %}
 ip address {{ interface.ip_address }} {{ interface.subnet_mask }}
{% endif %}
{% if interface.enabled is defined and not interface.enabled %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
{% endfor %}
{% endif %}
!
{% if vlans %}
! VLAN Configuration
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
{% if vlan.description %}
 description {{ vlan.description }}
{% endif %}
!
{% endfor %}
{% endif %}
!
{% if ospf and ospf.enabled %}
! OSPF Configuration
router ospf {{ ospf.process_id }}
{% if ospf.router_id %}
 router-id {{ ospf.router_id }}
{% endif %}
{% if ospf.networks %}
{% for network in ospf.networks %}
 network {{ network.network }} {{ network.wildcard }} area {{ network.area }}
{% endfor %}
{% endif %}
!
{% endif %}
!
{% if static_routes %}
! Static Routes
{% for route in static_routes %}
ip route {{ route.network }}{% if route.mask %} {{ route.mask }}{% endif %} {{ route.next_hop }}{% if route.distance %} {{ route.distance }}{% endif %}

{% endfor %}
!
{% endif %}
!
{% if ntp_servers %}
! NTP Configuration
{% for server in ntp_servers %}
ntp server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if dns_servers %}
! DNS Configuration
{% for server in dns_servers %}
ip name-server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if syslog_servers %}
! Syslog Configuration
{% for server in syslog_servers %}
logging host {{ server }}
{% endfor %}
logging trap informational
!
{% endif %}
!
{% if snmp_community %}
! SNMP Configuration
snmp-server community {{ snmp_community }} RO
{% if snmp_location %}
snmp-server location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-server contact {{ snmp_contact }}
{% endif %}
!
{% endif %}
!
{% if banner_motd %}
banner motd ^
{{ banner_motd }}
^
!
{% endif %}
!
{% if banner_login %}
banner login ^
{{ banner_login }}
^
!
{% endif %}
!
line con 0
 logging synchronous
 exec-timeout 30 0
line vty 0 4
 transport input ssh
 exec-timeout 30 0
!
end
