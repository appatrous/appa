!
! Cisco IOS-XR Configuration
! Generated by Cisco Configuration Generator
! Hostname: {{ hostname }}
! Platform: {{ platform }}
!
hostname {{ hostname }}
!
{% if domain_name %}
domain name {{ domain_name }}
{% endif %}
!
{% if aaa and aaa.tacacs_servers %}
! AAA Configuration
tacacs-server host {{ aaa.tacacs_servers[0].host }}
{% if aaa.tacacs_servers[0].key %}
 key {{ aaa.tacacs_servers[0].key }}
{% endif %}
!
aaa authentication login default group tacacs+ local
aaa authorization exec default group tacacs+ local
!
{% endif %}
!
{% if aaa and aaa.local_users %}
! Local Users
{% for username, password in aaa.local_users.items() %}
username {{ username }}
 group root-lr
 secret {{ password }}
!
{% endfor %}
{% endif %}
!
{% if interfaces %}
! Interface Configuration
{% for interface in interfaces %}
interface {{ interface.name }}
{% if interface.description %}
 description {{ interface.description }}
{% endif %}
{% if interface.ip_address and interface.subnet_mask %}
 ipv4 address {{ interface.ip_address }} {{ interface.subnet_mask }}
{% endif %}
{% if interface.enabled is defined and not interface.enabled %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
{% endfor %}
{% endif %}
!
{% if ospf and ospf.enabled %}
! OSPF Configuration
router ospf {{ ospf.process_id }}
{% if ospf.router_id %}
 router-id {{ ospf.router_id }}
{% endif %}
{% if ospf.networks %}
{% for network in ospf.networks %}
 area {{ network.area }}
  interface {{ network.interface | default('Loopback0') }}
 !
{% endfor %}
{% endif %}
!
{% endif %}
!
{% if static_routes %}
! Static Routes
router static
{% for route in static_routes %}
 address-family ipv4 unicast
  {{ route.network }}{% if route.mask %}/{{ route.mask }}{% endif %} {{ route.next_hop }}
 !
{% endfor %}
!
{% endif %}
!
{% if ntp_servers %}
! NTP Configuration
ntp
{% for server in ntp_servers %}
 server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if dns_servers %}
! DNS Configuration
{% for server in dns_servers %}
domain name-server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if syslog_servers %}
! Syslog Configuration
logging console informational
{% for server in syslog_servers %}
logging {{ server }} vrf default
{% endfor %}
!
{% endif %}
!
{% if snmp_community %}
! SNMP Configuration
snmp-server community {{ snmp_community }} RO
{% if snmp_location %}
snmp-server location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-server contact {{ snmp_contact }}
{% endif %}
!
{% endif %}
!
{% if banner_motd %}
banner motd #
{{ banner_motd }}
#
!
{% endif %}
!
ssh server v2
ssh timeout 30
!
end
