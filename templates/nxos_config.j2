!
! Cisco NX-OS Configuration
! Generated by Cisco Configuration Generator
! Hostname: {{ hostname }}
! Platform: {{ platform }}
!
version 9.3(5)
!
hostname {{ hostname }}
!
{% if domain_name %}
ip domain-name {{ domain_name }}
{% endif %}
!
{% if enable_secret %}
enable secret {{ enable_secret }}
{% endif %}
!
feature telnet
feature ssh
!
{% if vlans %}
! VLAN Configuration
{% for vlan in vlans %}
vlan {{ vlan.id }}
  name {{ vlan.name }}
{% if vlan.description %}
  description {{ vlan.description }}
{% endif %}
{% endfor %}
!
{% endif %}
!
{% if ospf and ospf.enabled %}
feature ospf
!
{% endif %}
!
{% if aaa and aaa.tacacs_servers %}
! AAA Configuration
feature tacacs+
{% for server in aaa.tacacs_servers %}
tacacs-server host {{ server.host }}{% if server.key %} key {{ server.key }}{% endif %}

{% endfor %}
aaa group server tacacs+ TACACS
{% for server in aaa.tacacs_servers %}
  server {{ server.host }}
{% endfor %}
!
aaa authentication login default group TACACS local
aaa authorization commands default group TACACS local
!
{% endif %}
!
{% if aaa and aaa.local_users %}
! Local Users
{% for username, password in aaa.local_users.items() %}
username {{ username }} password {{ password }} role network-admin
{% endfor %}
{% endif %}
!
{% if interfaces %}
! Interface Configuration
{% for interface in interfaces %}
interface {{ interface.name }}
{% if interface.description %}
  description {{ interface.description }}
{% endif %}
{% if interface.ip_address and interface.subnet_mask %}
  no switchport
  ip address {{ interface.ip_address }}/{{ interface.subnet_mask | replace('255.255.255.0', '24') | replace('255.255.0.0', '16') | replace('255.0.0.0', '8') }}
{% endif %}
{% if interface.enabled is defined and not interface.enabled %}
  shutdown
{% else %}
  no shutdown
{% endif %}
!
{% endfor %}
{% endif %}
!
{% if ospf and ospf.enabled %}
! OSPF Configuration
router ospf {{ ospf.process_id }}
{% if ospf.router_id %}
  router-id {{ ospf.router_id }}
{% endif %}
!
{% if ospf.networks %}
{% for network in ospf.networks %}
interface {{ network.interface | default('loopback0') }}
  ip router ospf {{ ospf.process_id }} area {{ network.area }}
{% endfor %}
{% endif %}
!
{% endif %}
!
{% if static_routes %}
! Static Routes
{% for route in static_routes %}
ip route {{ route.network }}{% if route.mask %} {{ route.mask }}{% endif %} {{ route.next_hop }}{% if route.distance %} {{ route.distance }}{% endif %}

{% endfor %}
!
{% endif %}
!
{% if ntp_servers %}
! NTP Configuration
{% for server in ntp_servers %}
ntp server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if dns_servers %}
! DNS Configuration
{% for server in dns_servers %}
ip name-server {{ server }}
{% endfor %}
!
{% endif %}
!
{% if syslog_servers %}
! Syslog Configuration
{% for server in syslog_servers %}
logging server {{ server }} 6
{% endfor %}
!
{% endif %}
!
{% if snmp_community %}
! SNMP Configuration
snmp-server community {{ snmp_community }} ro
{% if snmp_location %}
snmp-server location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-server contact {{ snmp_contact }}
{% endif %}
!
{% endif %}
!
{% if banner_motd %}
banner motd #
{{ banner_motd }}
#
!
{% endif %}
!
line console
  exec-timeout 30
line vty
  exec-timeout 30
!
end
